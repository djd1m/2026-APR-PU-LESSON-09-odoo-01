{
  "name": "RemontERP Dev",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "forwardPorts": [10069, 10379, 10432, 10900, 10901],
  "portsAttributes": {
    "10069": {
      "label": "Odoo 19 UI",
      "onAutoForward": "notify",
      "visibility": "public"
    },
    "10432": {
      "label": "PostgreSQL 16",
      "onAutoForward": "silent"
    },
    "10379": {
      "label": "Redis 7",
      "onAutoForward": "silent"
    },
    "10900": {
      "label": "MinIO S3 API",
      "onAutoForward": "silent",
      "visibility": "public"
    },
    "10901": {
      "label": "MinIO Console",
      "onAutoForward": "silent",
      "visibility": "public"
    }
  },
  "postCreateCommand": "bash .devcontainer/bootstrap.sh",
  "postStartCommand": "docker compose up -d 2>/dev/null || true"
}
