# ============================================================
# RemontERP Environment Variables
# Copy this file to .env and fill in actual values.
# NEVER commit .env with real secrets to version control.
# ============================================================

# ── PostgreSQL ──────────────────────────────────────────────
POSTGRES_DB=remont_erp
POSTGRES_USER=odoo
POSTGRES_PASSWORD=          # Strong password for PostgreSQL

# ── Odoo ────────────────────────────────────────────────────
ODOO_ADMIN_USER=admin       # Odoo admin login (for JSON-RPC from workers)
ODOO_ADMIN_PASSWORD=        # Odoo admin password

# ── JWT ─────────────────────────────────────────────────────
# CRITICAL: Application will NOT start without this.
# Generate with: openssl rand -hex 64
JWT_SECRET=

# ── Redis ───────────────────────────────────────────────────
REDIS_PASSWORD=             # Strong password for Redis

# ── MinIO (S3-compatible object storage) ────────────────────
MINIO_ACCESS_KEY=           # MinIO root user (min 3 characters)
MINIO_SECRET_KEY=           # MinIO root password (min 8 characters)
MINIO_BUCKET=remont-media   # Default bucket for photos and videos

# ── YuKassa (payment gateway) ──────────────────────────────
YUKASSA_SHOP_ID=            # YuKassa shop ID
YUKASSA_SECRET_KEY=         # YuKassa secret key for API and HMAC verification

# ── Telegram Bot ────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=         # Bot token from @BotFather

# ── CV Worker ───────────────────────────────────────────────
CV_BACKEND=yolo             # Backend: 'yolo' (local YOLOv8) or 'vllm' (Vision LLM API)
CV_CONFIDENCE_THRESHOLD=0.6 # Minimum confidence for stage detection (0.0-1.0)

# ── vLLM Backend (only if CV_BACKEND=vllm) ────────────────
# Supports: OpenAI, Claude (via proxy), self-hosted vLLM, llama.cpp
VLLM_API_URL=               # OpenAI-compatible API URL (e.g., https://api.openai.com/v1)
VLLM_API_KEY=               # API key
VLLM_MODEL=gpt-4o           # Model name (gpt-4o, gpt-4o-mini, etc.)
VLLM_TIMEOUT=30             # API timeout in seconds

# ── Timelapse Worker ────────────────────────────────────────
TIMELAPSE_FPS=30            # Frames per second for generated timelapses
TIMELAPSE_RESOLUTION=1920x1080  # Output resolution (WxH)

# ── Domain (for SSL / Nginx) ───────────────────────────────
DOMAIN=erp.example.com      # Your domain name for SSL certificate
ADMIN_EMAIL=admin@example.com  # Email for Let's Encrypt notifications
