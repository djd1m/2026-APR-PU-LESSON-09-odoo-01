<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Portal: My Projects List -->
    <template id="portal_my_projects" name="My Renovation Projects">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar">
                <t t-set="title">My Renovations</t>
            </t>

            <div class="o_portal_my_projects">
                <t t-if="projects">
                    <div class="row">
                        <t t-foreach="projects" t-as="project">
                            <div class="col-md-6 col-lg-4 mb-3">
                                <div class="card h-100 remont-project-card">
                                    <div class="card-body">
                                        <h5 class="card-title">
                                            <a t-attf-href="/my/projects/#{project.id}">
                                                <t t-out="project.name"/>
                                            </a>
                                        </h5>
                                        <p class="card-text text-muted">
                                            <t t-out="project.address"/>
                                        </p>
                                        <span t-attf-class="badge #{project.status == 'completed' and 'bg-success' or project.status == 'in_progress' and 'bg-primary' or 'bg-secondary'}">
                                            <t t-out="dict(project._fields['status'].selection).get(project.status, '')"/>
                                        </span>
                                    </div>
                                    <div class="card-footer text-muted small">
                                        <t t-if="project.start_date">
                                            Started: <t t-out="project.start_date"/>
                                        </t>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>
                </t>
                <t t-else="">
                    <div class="alert alert-info">
                        You have no renovation projects yet.
                    </div>
                </t>
            </div>
        </t>
    </template>

    <!-- Portal: Project Detail -->
    <template id="portal_project_detail" name="Renovation Project Detail">
        <t t-call="portal.portal_layout">
            <t t-set="o_portal_fullwidth_alert" groups=""/>

            <div class="container remont-project-detail">
                <div class="row mb-4">
                    <div class="col-12">
                        <h2><t t-out="project.name"/></h2>
                        <p class="text-muted"><t t-out="project.address"/></p>
                    </div>
                </div>

                <!-- Stage Progress -->
                <div class="row mb-4">
                    <div class="col-12">
                        <h4>Stage Progress</h4>
                        <t t-foreach="stages" t-as="stage">
                            <div class="mb-2">
                                <div class="d-flex justify-content-between">
                                    <span>
                                        <t t-out="dict(stage._fields['name'].selection).get(stage.name, '')"/>
                                    </span>
                                    <span>
                                        <t t-out="'%.0f' % stage.progress_pct"/>%
                                    </span>
                                </div>
                                <div class="progress" style="height: 20px;">
                                    <div class="progress-bar"
                                         role="progressbar"
                                         t-attf-style="width: #{stage.progress_pct}%;"
                                         t-att-aria-valuenow="stage.progress_pct"
                                         aria-valuemin="0"
                                         aria-valuemax="100">
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>
                </div>

                <!-- Budget Overview -->
                <div class="row mb-4">
                    <div class="col-md-6">
                        <h4>Budget Overview</h4>
                        <table class="table table-sm">
                            <tr>
                                <td>Estimated</td>
                                <td class="text-end">
                                    <t t-out="'%.2f' % budget_estimate"/>
                                </td>
                            </tr>
                            <tr>
                                <td>Spent</td>
                                <td class="text-end">
                                    <t t-out="'%.2f' % budget_actual"/>
                                </td>
                            </tr>
                            <tr class="fw-bold">
                                <td>Remaining</td>
                                <td class="text-end">
                                    <t t-out="'%.2f' % budget_remaining"/>
                                </td>
                            </tr>
                        </table>
                    </div>
                    <div class="col-md-6">
                        <h4>Budget Chart</h4>
                        <div class="remont-budget-chart">
                            <div class="d-flex align-items-center mb-2">
                                <div class="remont-budget-bar bg-primary"
                                     t-attf-style="width: #{budget_estimate and (budget_actual / budget_estimate * 100) or 0}%;">
                                </div>
                                <span class="ms-2 small">Spent</span>
                            </div>
                            <div class="d-flex align-items-center">
                                <div class="remont-budget-bar bg-success"
                                     t-attf-style="width: #{budget_estimate and (budget_remaining / budget_estimate * 100) or 0}%;">
                                </div>
                                <span class="ms-2 small">Remaining</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Photos / Snapshots -->
                <div class="row mb-4">
                    <div class="col-12">
                        <h4>Photos</h4>
                        <div class="row">
                            <t t-foreach="snapshots[:12]" t-as="snap">
                                <div class="col-4 col-md-3 col-lg-2 mb-2">
                                    <img t-att-src="snap.thumbnail_url or snap.image_url"
                                         class="img-fluid rounded remont-snapshot-thumb"
                                         t-att-alt="snap.captured_at"/>
                                </div>
                            </t>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- Portal: Public Timelapse Share -->
    <template id="portal_share_timelapse" name="Shared Timelapse">
        <t t-call="website.layout">
            <div class="container py-5">
                <div class="row justify-content-center">
                    <div class="col-lg-8">
                        <h2 class="mb-3">
                            Timelapse: <t t-out="project.name"/>
                        </h2>
                        <p class="text-muted mb-4">
                            <t t-out="project.address"/>
                        </p>
                        <div class="ratio ratio-16x9">
                            <video controls="controls"
                                   t-att-src="timelapse.video_url"
                                   class="rounded">
                                Your browser does not support the video tag.
                            </video>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

</odoo>
