<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Add "My Renovations" entry to the portal sidebar -->
    <template id="portal_my_home_remont"
              name="Portal: My Renovations"
              inherit_id="portal.portal_my_home"
              priority="40">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'fa fa-home'"/>
                <t t-set="title">My Renovations</t>
                <t t-set="url" t-value="'/my/projects'"/>
                <t t-set="text">View your renovation projects</t>
                <t t-set="placeholder_count" t-value="'project_count'"/>
            </t>
        </xpath>
    </template>

</odoo>
