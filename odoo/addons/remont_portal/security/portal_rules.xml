<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Record Rules: Portal users can only read projects they own.
        These rules enforce data isolation at the ORM level,
        complementing the controller-level ownership checks.
    -->

    <!-- Portal users: see only their own projects -->
    <record id="rule_portal_project_owner" model="ir.rule">
        <field name="name">Portal: own projects only</field>
        <field name="model_id" ref="remont_core.model_remont_project"/>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="domain_force">[('owner_id', '=', user.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Portal users: see stages of their own projects only -->
    <record id="rule_portal_stage_owner" model="ir.rule">
        <field name="name">Portal: own project stages only</field>
        <field name="model_id" ref="remont_core.model_remont_stage"/>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="domain_force">[('project_id.owner_id', '=', user.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Portal users: see snapshots of their own projects only -->
    <record id="rule_portal_snapshot_owner" model="ir.rule">
        <field name="name">Portal: own project snapshots only</field>
        <field name="model_id" ref="remont_core.model_remont_snapshot"/>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="domain_force">[('project_id.owner_id', '=', user.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Portal users: see timelapses of their own projects only -->
    <record id="rule_portal_timelapse_owner" model="ir.rule">
        <field name="name">Portal: own project timelapses only</field>
        <field name="model_id" ref="remont_camera.model_remont_timelapse"/>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="domain_force">[('project_id.owner_id', '=', user.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Portal users: see cameras of their own projects only -->
    <record id="rule_portal_camera_owner" model="ir.rule">
        <field name="name">Portal: own project cameras only</field>
        <field name="model_id" ref="remont_camera.model_remont_camera"/>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="domain_force">[('project_id.owner_id', '=', user.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

</odoo>
