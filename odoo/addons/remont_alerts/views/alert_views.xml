<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Alert Tree View -->
    <record id="view_remont_alert_tree" model="ir.ui.view">
        <field name="name">remont.alert.tree</field>
        <field name="model">remont.alert</field>
        <field name="arch" type="xml">
            <tree string="Alerts"
                  decoration-danger="severity == 'critical'"
                  decoration-warning="severity == 'warning'"
                  decoration-muted="is_read == True">
                <field name="created_at"/>
                <field name="type" widget="badge"/>
                <field name="severity" widget="badge"/>
                <field name="message"/>
                <field name="project_id"/>
                <field name="user_id"/>
                <field name="is_read"/>
            </tree>
        </field>
    </record>

    <!-- Alert Form View -->
    <record id="view_remont_alert_form" model="ir.ui.view">
        <field name="name">remont.alert.form</field>
        <field name="model">remont.alert</field>
        <field name="arch" type="xml">
            <form string="Alert">
                <sheet>
                    <group>
                        <group string="Alert Details">
                            <field name="type"/>
                            <field name="severity"/>
                            <field name="is_read"/>
                            <field name="created_at"/>
                            <field name="cooldown_until"/>
                        </group>
                        <group string="Context">
                            <field name="project_id"/>
                            <field name="user_id"/>
                        </group>
                    </group>
                    <group string="Message">
                        <field name="message" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Alert Search View -->
    <record id="view_remont_alert_search" model="ir.ui.view">
        <field name="name">remont.alert.search</field>
        <field name="model">remont.alert</field>
        <field name="arch" type="xml">
            <search string="Search Alerts">
                <field name="message"/>
                <field name="project_id"/>
                <field name="user_id"/>
                <separator/>
                <filter string="Unread" name="unread"
                        domain="[('is_read', '=', False)]"/>
                <separator/>
                <filter string="Crew Absence" name="type_absence"
                        domain="[('type', '=', 'absence')]"/>
                <filter string="Budget Overrun" name="type_overbudget"
                        domain="[('type', '=', 'overbudget')]"/>
                <filter string="Schedule Delay" name="type_delay"
                        domain="[('type', '=', 'delay')]"/>
                <filter string="Camera Error" name="type_camera_error"
                        domain="[('type', '=', 'camera_error')]"/>
                <separator/>
                <filter string="Critical" name="severity_critical"
                        domain="[('severity', '=', 'critical')]"/>
                <filter string="Warning" name="severity_warning"
                        domain="[('severity', '=', 'warning')]"/>
                <filter string="Info" name="severity_info"
                        domain="[('severity', '=', 'info')]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Type" name="group_type"
                            context="{'group_by': 'type'}"/>
                    <filter string="Severity" name="group_severity"
                            context="{'group_by': 'severity'}"/>
                    <filter string="Project" name="group_project"
                            context="{'group_by': 'project_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Alert Action -->
    <record id="action_remont_alert" model="ir.actions.act_window">
        <field name="name">Alerts</field>
        <field name="res_model">remont.alert</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_remont_alert_search"/>
        <field name="context">{'search_default_unread': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No alerts
            </p>
            <p>
                Alerts are generated automatically when the system detects
                crew absence, budget overruns, or schedule delays.
            </p>
        </field>
    </record>

    <!-- Alert Menu -->
    <menuitem id="menu_remont_alerts"
              name="Alerts"
              parent="remont_core.menu_remont_root"
              action="action_remont_alert"
              sequence="30"/>

</odoo>
