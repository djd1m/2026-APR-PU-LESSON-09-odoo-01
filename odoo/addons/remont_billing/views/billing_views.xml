<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Subscription Tree View -->
    <record id="view_subscription_tree" model="ir.ui.view">
        <field name="name">remont.subscription.tree</field>
        <field name="model">remont.subscription</field>
        <field name="arch" type="xml">
            <tree decoration-success="status=='active'" decoration-muted="status in ('expired','cancelled')">
                <field name="user_id"/>
                <field name="plan"/>
                <field name="status"/>
                <field name="amount" widget="monetary"/>
                <field name="currency_id" invisible="1"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="auto_renew"/>
            </tree>
        </field>
    </record>

    <!-- Subscription Form View -->
    <record id="view_subscription_form" model="ir.ui.view">
        <field name="name">remont.subscription.form</field>
        <field name="model">remont.subscription</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="status" widget="statusbar" statusbar_visible="trial,active,expired"/>
                </header>
                <sheet>
                    <group>
                        <group string="Subscription">
                            <field name="user_id"/>
                            <field name="plan"/>
                            <field name="auto_renew"/>
                        </group>
                        <group string="Billing">
                            <field name="amount" widget="monetary"/>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Payment Tree View -->
    <record id="view_payment_tree" model="ir.ui.view">
        <field name="name">remont.payment.tree</field>
        <field name="model">remont.payment</field>
        <field name="arch" type="xml">
            <tree decoration-success="status=='succeeded'" decoration-danger="status in ('failed','canceled')">
                <field name="yukassa_id"/>
                <field name="subscription_id"/>
                <field name="amount" widget="monetary"/>
                <field name="currency_id" invisible="1"/>
                <field name="status"/>
                <field name="webhook_verified"/>
                <field name="paid_at"/>
            </tree>
        </field>
    </record>

    <!-- Payment Form View -->
    <record id="view_payment_form" model="ir.ui.view">
        <field name="name">remont.payment.form</field>
        <field name="model">remont.payment</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="status" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="yukassa_id"/>
                            <field name="subscription_id"/>
                            <field name="amount" widget="monetary"/>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                        </group>
                        <group>
                            <field name="status"/>
                            <field name="webhook_verified"/>
                            <field name="paid_at"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_subscription" model="ir.actions.act_window">
        <field name="name">Subscriptions</field>
        <field name="res_model">remont.subscription</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="action_payment" model="ir.actions.act_window">
        <field name="name">Payments</field>
        <field name="res_model">remont.payment</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Menus -->
    <menuitem id="menu_billing"
              name="Billing"
              parent="remont_core.menu_remont_root"
              sequence="60"/>
    <menuitem id="menu_subscription"
              name="Subscriptions"
              parent="menu_billing"
              action="action_subscription"
              sequence="10"/>
    <menuitem id="menu_payment"
              name="Payments"
              parent="menu_billing"
              action="action_payment"
              sequence="20"/>
</odoo>
