<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Project Form View -->
    <record id="view_remont_project_form" model="ir.ui.view">
        <field name="name">remont.project.form</field>
        <field name="model">remont.project</field>
        <field name="arch" type="xml">
            <form string="Renovation Project">
                <header>
                    <field name="status" widget="statusbar"
                           statusbar_visible="draft,planning,in_progress,completed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Project Name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="General">
                            <field name="address"/>
                            <field name="area_sqm"/>
                            <field name="type"/>
                            <field name="owner_id"/>
                            <field name="contractor_id"/>
                        </group>
                        <group string="Schedule">
                            <field name="start_date"/>
                            <field name="end_date_plan"/>
                            <field name="end_date_predict"/>
                        </group>
                    </group>
                    <group string="Budget &amp; Progress">
                        <group>
                            <field name="currency_id" invisible="1"/>
                            <field name="budget_estimate"/>
                            <field name="budget_actual"/>
                        </group>
                        <group>
                            <field name="overall_progress" widget="progressbar"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Stages" name="stages">
                            <field name="stage_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="status"/>
                                    <field name="progress_pct" widget="progressbar"/>
                                    <field name="planned_start"/>
                                    <field name="planned_end"/>
                                    <field name="actual_start"/>
                                    <field name="actual_end"/>
                                </list>
                            </field>
                        </page>
                        <!-- Snapshots tab added by remont_camera module -->
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Project List View -->
    <record id="view_remont_project_list" model="ir.ui.view">
        <field name="name">remont.project.list</field>
        <field name="model">remont.project</field>
        <field name="arch" type="xml">
            <list string="Renovation Projects">
                <field name="name"/>
                <field name="address"/>
                <field name="type"/>
                <field name="status"/>
                <field name="owner_id"/>
                <field name="contractor_id"/>
                <field name="start_date"/>
                <field name="end_date_plan"/>
                <field name="budget_estimate"/>
                <field name="budget_actual"/>
            </list>
        </field>
    </record>

    <!-- Project Kanban View -->
    <record id="view_remont_project_kanban" model="ir.ui.view">
        <field name="name">remont.project.kanban</field>
        <field name="model">remont.project</field>
        <field name="arch" type="xml">
            <kanban default_group_by="status" class="o_kanban_small_column">
                <field name="name"/>
                <field name="address"/>
                <field name="status"/>
                <field name="owner_id"/>
                <field name="contractor_id"/>
                <field name="overall_progress"/>
                <field name="budget_estimate"/>
                <field name="budget_actual"/>
                <field name="currency_id"/>
                <templates>
                    <t t-name="kanban-card">
                        <div class="oe_kanban_content">
                            <div class="o_kanban_record_top mb-0">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                </div>
                            </div>
                            <div class="o_kanban_record_body">
                                <field name="address"/>
                                <br/>
                                <span>Owner: <field name="owner_id"/></span>
                                <br/>
                                <span>Contractor: <field name="contractor_id"/></span>
                                <div class="mt-2">
                                    <field name="overall_progress" widget="progressbar"
                                           options="{'editable': false}"/>
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <span>Budget: <field name="budget_estimate"
                                                         widget="monetary"
                                                         options="{'currency_field': 'currency_id'}"/></span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Project Action -->
    <record id="action_remont_project" model="ir.actions.act_window">
        <field name="name">Renovation Projects</field>
        <field name="res_model">remont.project</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

</odoo>
