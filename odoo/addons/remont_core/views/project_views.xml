<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Project Form View -->
    <record id="view_remont_project_form" model="ir.ui.view">
        <field name="name">remont.project.form</field>
        <field name="model">remont.project</field>
        <field name="arch" type="xml">
            <form string="Проект ремонта">
                <header>
                    <field name="status" widget="statusbar"
                           statusbar_visible="draft,planning,in_progress,completed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_snapshots"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-camera">
                            <field name="snapshot_count" widget="statinfo"
                                   string="Фото"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Project Name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Общее">
                            <field name="address"/>
                            <field name="area_sqm"/>
                            <field name="type"/>
                            <field name="owner_id"/>
                            <field name="contractor_id"/>
                        </group>
                        <group string="Сроки">
                            <field name="start_date"/>
                            <field name="end_date_plan"/>
                            <field name="end_date_predict"/>
                        </group>
                    </group>
                    <group string="Бюджет и прогресс">
                        <group>
                            <field name="currency_id" invisible="1"/>
                            <field name="budget_estimate"/>
                            <field name="budget_actual"/>
                        </group>
                        <group>
                            <field name="overall_progress" widget="progressbar"/>
                        </group>
                    </group>
                    <group string="Прогресс ремонта (AI)">
                        <group>
                            <field name="current_stage"/>
                            <field name="current_stage_confidence"
                                   widget="progressbar"/>
                            <field name="last_snapshot_at"/>
                        </group>
                        <group>
                            <field name="bottleneck_stage"/>
                            <field name="needs_review_count"/>
                            <field name="stage_distribution_json"
                                   string="Распределение"
                                   readonly="1"/>
                        </group>
                    </group>
                    <group string="Задержки и прогноз">
                        <group>
                            <field name="delay_days"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Этапы ремонта" name="stages">
                            <field name="stage_ids">
                                <list editable="bottom"
                                      decoration-danger="delay_status == 'red'"
                                      decoration-warning="delay_status == 'yellow'"
                                      decoration-success="delay_status == 'green'">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="status"/>
                                    <field name="progress_pct" widget="progressbar"/>
                                    <field name="planned_start"/>
                                    <field name="planned_end"/>
                                    <field name="actual_start"/>
                                    <field name="actual_end"/>
                                    <field name="delay_days"/>
                                    <field name="delay_status" invisible="1"/>
                                    <button name="action_view_stage_snapshots"
                                            type="object"
                                            string="Снимки"
                                            icon="fa-camera"
                                            class="btn-link"/>
                                </list>
                            </field>
                        </page>
                        <page string="AI Отчёт" name="ai_summary">
                            <group>
                                <button name="action_generate_ai_summary"
                                        type="object"
                                        string="Сгенерировать AI отчёт"
                                        icon="fa-magic"
                                        class="btn-primary"/>
                                <field name="ai_summary_date" readonly="1"/>
                            </group>
                            <field name="ai_summary" readonly="1"
                                   placeholder="Нажмите кнопку выше для генерации AI отчёта о состоянии ремонта"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Project List View -->
    <record id="view_remont_project_list" model="ir.ui.view">
        <field name="name">remont.project.list</field>
        <field name="model">remont.project</field>
        <field name="arch" type="xml">
            <list string="Проекты ремонта"
                  decoration-danger="delay_days > 3"
                  decoration-warning="delay_days > 0 and delay_days &lt;= 3">
                <field name="name"/>
                <field name="address"/>
                <field name="type"/>
                <field name="status"/>
                <field name="overall_progress" widget="progressbar"/>
                <field name="delay_days"/>
                <field name="current_stage"
                       decoration-success="current_stage_confidence &gt;= 0.65"
                       decoration-warning="current_stage_confidence &gt; 0 and current_stage_confidence &lt; 0.65"
                       decoration-muted="current_stage_confidence == 0"/>
                <field name="current_stage_confidence" widget="progressbar"/>
                <field name="bottleneck_stage" optional="show"/>
                <field name="needs_review_count" optional="show"/>
                <field name="snapshot_count" optional="show" string="Фото"/>
                <field name="owner_id" optional="hide"/>
                <field name="contractor_id" optional="hide"/>
                <field name="start_date" optional="hide"/>
                <field name="end_date_plan" optional="hide"/>
                <field name="budget_estimate" optional="show"/>
                <field name="budget_actual" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Project Kanban View -->
    <record id="view_remont_project_kanban" model="ir.ui.view">
        <field name="name">remont.project.kanban</field>
        <field name="model">remont.project</field>
        <field name="arch" type="xml">
            <kanban default_group_by="status" class="o_kanban_small_column">
                <field name="name"/>
                <field name="address"/>
                <field name="status"/>
                <field name="owner_id"/>
                <field name="contractor_id"/>
                <field name="overall_progress"/>
                <field name="budget_estimate"/>
                <field name="budget_actual"/>
                <field name="currency_id"/>
                <field name="current_stage"/>
                <field name="current_stage_confidence"/>
                <field name="bottleneck_stage"/>
                <field name="needs_review_count"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_content">
                            <div class="o_kanban_record_top mb-0">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                </div>
                            </div>
                            <div class="o_kanban_record_body">
                                <field name="address"/>
                                <div class="mt-2">
                                    <t t-if="record.current_stage.raw_value">
                                        <span class="badge text-bg-success"
                                              t-if="record.current_stage_confidence.raw_value &gt;= 0.65">
                                            <i class="fa fa-check-circle me-1"/>
                                            <field name="current_stage"/>
                                        </span>
                                        <span class="badge text-bg-warning"
                                              t-elif="record.current_stage_confidence.raw_value &gt; 0">
                                            <i class="fa fa-question-circle me-1"/>
                                            <field name="current_stage"/>
                                        </span>
                                        <span class="badge text-bg-secondary" t-else="">
                                            <field name="current_stage"/>
                                        </span>
                                    </t>
                                    <t t-if="record.bottleneck_stage.raw_value">
                                        <span class="badge text-bg-danger ms-1"
                                              title="Bottleneck">
                                            <i class="fa fa-exclamation-triangle me-1"/>
                                            <field name="bottleneck_stage"/>
                                        </span>
                                    </t>
                                </div>
                                <div class="mt-2">
                                    <field name="overall_progress" widget="progressbar"
                                           options="{'editable': false}"/>
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <span>
                                        <i class="fa fa-camera me-1"/>
                                        <field name="snapshot_count"/>
                                    </span>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <span>
                                        <field name="budget_estimate"
                                               widget="monetary"
                                               options="{'currency_field': 'currency_id'}"/>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Project Action -->
    <record id="action_remont_project" model="ir.actions.act_window">
        <field name="name">Проекты ремонта</field>
        <field name="res_model">remont.project</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

</odoo>
